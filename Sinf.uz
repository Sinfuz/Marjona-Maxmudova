"Rus tili":{e:[["“Книга” so‘zi o‘zbekchada nima?",["Qalam","Kitob","Daftar"],1],["“Спасибо” nima degani?",["Rahmat","Kechirasiz","Xayr"],0],["“Дом” so‘zi nimani anglatadi?",["Mashina","Maktab","Uy"],2]],h:[["“Здравствуйте” qanday ma’noni anglatadi?",["Xayr","Salom (hurmat bilan)","Yaxshi tun"],1],["“Я учусь в школе” gapining tarjimasi qaysi?",["Men maktabda o‘qiyman","Men uyga boraman","Men kitob o‘qiyman"],0],["“Спокойной ночи” nima degani?",["Xayrli tong","Xayrli kun","Xayrli tun"],2]]},
"Informatika":{e:[["Kompyuterning “miyasi” deb qaysi qurilma aytiladi?",["Protsessor","Sichqoncha","Monitor"],0],["Ma’lumot kiritish qurilmasi qaysi?",["Printer","Klaviatura","Monitor"],1],["Internetda ma’lumot qidirish uchun nima ishlatiladi?",["Printer","Skaner","Brauzer"],2]],h:[["1 bayt necha bitga teng?",["4","8","16"],1],["Ikkilik sanoq tizimida qaysi raqamlar ishlatiladi?",["1 va 2","0 dan 9 gacha","0 va 1"],2],["“.docx” kengaytmali fayl qaysi dasturga tegishli?",["Word","Excel","Paint"],0]]},
"Tasviriy san’at":{e:[["Asosiy ranglar qaysilar?",["Yashil, qora, oq","Qizil, sariq, ko‘k","Pushti, binafsha, jigarrang"],1],["Qizil va sariq aralashmasidan qaysi rang hosil bo‘ladi?",["Yashil","To‘q sariq","Binafsha"],1],["Rasm chizishda qaysi asbob ishlatiladi?",["Mo‘yqalam","Bolg‘a","Qaychi"],0]],h:[["Portret nimani tasvirlaydi?",["Tabiat manzarasini","Odam yuzini","Meva-chevalarni"],1],["Natyurmort nimani tasvirlaydi?",["Jang manzarasini","Odam portretini","Jonsiz narsalarni (meva, gul, idish)"],2],["Ko‘k va sariq aralashmasidan qaysi rang hosil bo‘ladi?",["Yashil","Qizil","Qora"],0]]},
"Musiqa":{e:[["Do, re, mi, fa, sol, la, si: nechta nota?",["5","7","9"],1],["Dutor qanday cholg‘u asbobi?",["Puflama","Urma","Torli"],2],["Doira qanday cholg‘u asbobi?",["Urma","Torli","Puflama"],0]],h:[["Karnay qanday cholg‘u asbobi?",["Torli","Puflama","Urma"],1],["Nay qanday cholg‘u asbobi?",["Torli","Urma","Puflama"],2],["Musiqada “temp” nimani bildiradi?",["Musiqaning tezligini","Ovoz balandligini","Nota uzunligini"],0]]},
"Jismoniy tarbiya":{e:[["Mashqdan oldin nima qilish kerak?",["Uxlash","Qizdirinish (razminka)","Ko‘p ovqat yeyish"],1],["Futbol jamoasida maydonda nechta o‘yinchi bo‘ladi?",["9","11","15"],1],["Sog‘lom bo‘lish uchun nima foydali?",["Kun bo‘yi o‘tirish","Kam suv ichish","Muntazam mashq"],2]],h:[["Voleybolda maydonda jamoadan nechta o‘yinchi bo‘ladi?",["6","9","11"],0],["Basketbol to‘pi asosan qaysi uzvlar bilan o‘ynaladi?",["Oyoq bilan","Qo‘l bilan","Bosh bilan"],1],["Yurak urishini qayerdan sanash mumkin?",["Tizza","Tirsak","Bilak tomiri"],2]]},
"Texnologiya":{e:[["Mato kesish uchun nima ishlatiladi?",["Bolg‘a","Qaychi","Arra"],1],["Yog‘ochni kesish uchun qaysi asbob kerak?",["Arra","Igna","Mo‘yqalam"],0],["Xavfsizlik qoidalariga rioya qilish nima uchun kerak?",["Vaqt o‘tkazish uchun","Hech nima uchun","Jarohatdan saqlanish uchun"],2]],h:[["Uzunlikni o‘lchash uchun qaysi asbob ishlatiladi?",["Bolg‘a","Chizg‘ich (metr)","Arra"],1],["Ovqat tayyorlashda qaysi gigiyena qoidasiga amal qilinadi?",["Qo‘lni yuvmaslik","Mevani yuvmasdan yeyish","Qo‘lni yuvish"],2],["Qaysi material qayta tiklanadigan resurs hisoblanadi?",["Yog‘och","Neft","Ko‘mir"],0]]}
};
</script>
<script>
(function(){
  var LV=["","Juda oson","Oson","O‘rta","Qiyin","Juda qiyin"],aiState="unknown",sp=null,baseNoted=false;
  function getSample(){
    if(!sp)sp=Promise.resolve().then(function(){return window.claude&&window.claude.use?window.claude.use("sample"):null}).catch(function(){return null});
    return sp;
  }
  function mk(t){var b=document.createElement("button");b.type="button";b.className="chip";b.textContent=t;return b;}
  function valid(o){return o&&typeof o.q==="string"&&o.q&&Array.isArray(o.o)&&o.o.length===3&&o.o.every(function(x){return typeof x==="string"&&x})&&Number.isInteger(o.a)&&o.a>=0&&o.a<=2;}
  function local(subject,level,asked){
    var B=(window.SB||{})[subject];if(!B)return {q:"7 × 8 = ?",o:["54","56","64"],a:1,src:"base"};
    var all=level<=2?B.e:level>=4?B.h:B.e.concat(B.h);
    var pool=all.filter(function(x){return asked.indexOf(x[0])<0});if(!pool.length)pool=all;
    var x=pool[Math.floor(Math.random()*pool.length)];return {q:x[0],o:x[1].slice(),a:x[2],src:"base"};
  }
  function fetchQ(subject,level,asked){
    var chain=Promise.resolve(null);
    if(aiState!=="off"){
      chain=getSample().then(function(s){
        if(!s){aiState="off";return null;}
        var prompt="Sen O‘zbekiston maktab o‘qituvchisisan. "+subject+" fanidan maktab dasturiga mos 1 ta test savoli tuz. Qiyinlik darajasi: "+level+" (1 = juda oson, 5 = juda qiyin). Savol va javoblar o‘zbek tilida bo‘lsin (ingliz yoki rus tili fanida kerakli so‘zlar o‘sha tilda bo‘lishi mumkin). Aniq 3 ta javob varianti bo‘lsin, faqat bittasi to‘g‘ri. To‘g‘ri javob o‘rni tasodifiy bo‘lsin. Bu savollarni takrorlama: "+asked.slice(-8).join(\" | \")+". Faqat JSON qaytar, boshqa matn yozma: {\"q\":\"savol\",\"o\":[\"variant1\",\"variant2\",\"variant3\"],\"a\":0} (a = to‘g‘ri variantning tartib raqami, 0 dan 2 gacha).";
        return s.json(prompt,{modelTier:"quick",cache:false}).then(function(o){if(valid(o)){aiState="on";o.src="ai";return o;}return null;},function(e){var c=e&&e.code;if(["not_granted","sampling_disabled","not_declared","capability_disabled","capability_removed"].indexOf(c)>=0)aiState="off";return null;});
      });
    }
    return chain.then(function(q){return q||local(subject,level,asked);});
  }
  window.sinfPractice=function(box,subject,start,onScore,onExit){
    var level=start,streak=0,n=0,right=0,asked=[];
    function next(){
      box.innerHTML="<p><small></small></p><p>Savol tayyorlanmoqda…</p>";
      box.querySelector("small").textContent=subject+" · Daraja "+level+": "+LV[level]+" · Savol "+(n+1);
      fetchQ(subject,level,asked).then(show);
    }
    function show(q){
      asked.push(q.q);
      box.innerHTML="<p><small></small></p><p><b></b></p>";
      box.querySelector("small").textContent=subject+" · Daraja "+level+": "+LV[level]+" · Savol "+(n+1);
      box.querySelector("b").textContent=q.q;
      var chips=[];
      q.o.forEach(function(t,j){var b=mk(t);chips.push(b);b.addEventListener("click",function(){
        chips.forEach(function(x){x.disabled=true});
        var ok=j===q.a,up=false;b.classList.add(ok?"good":"bad");if(!ok)chips[q.a].classList.add("good");window.sinfLog&&window.sinfLog({q:q.q,ok:ok,s:subject,l:level});
        n++;
        if(ok){right++;streak++;if(onScore)onScore(10);if(streak>=2&&level<5){level++;streak=0;up=true;}}
        else{streak=0;if(level>1)level--;}
        var fb=document.createElement("p");fb.style.fontWeight="600";
        fb.textContent=ok?(up?"Barakalla! Keyingi savol qiyinroq bo‘ladi.":"To‘g‘ri!"):"Xato. Keyingi savol osonroq bo‘ladi.";
        box.appendChild(fb);
        var nb=mk("Keyingi savol →");nb.addEventListener("click",next);box.appendChild(nb);
        var fin=mk("Tugatish");fin.addEventListener("click",summary);box.appendChild(fin);
      });box.appendChild(b);});
      if(q.src==="base"&&!baseNoted){baseNoted=true;var nt=document.createElement("p");nt.style.color="var(--muted)";nt.style.fontSize="14px";nt.textContent="AI hozir mavjud emas: tayyor savollar bazasidan foydalanilmoqda.";box.appendChild(nt);}
    }
    function summary(){
      var acc=n?Math.round(right/n*100):0;
      var msg=acc>=80?"Tabriklaymiz! Ajoyib natija! 🎉🌟":acc>=50?"Barakalla! Yaxshi natija! 👏":"Yaxshi urinish! Mashq qilishda davom eting 💪";
      box.innerHTML="<p style='font-size:20px'><b></b></p><p></p>";
      box.querySelector("b").textContent=msg;
      box.querySelectorAll("p")[1].textContent=n+" ta savol, "+right+" ta to‘g‘ri ("+acc+"%). Yakuniy daraja: "+level+" ("+LV[level]+").";
      if(acc>=80&&n>=3&&window.sinfBoom)window.sinfBoom();
      var again=mk("Yana mashq");again.addEventListener("click",function(){window.sinfPractice(box,subject,level,onScore,onExit);});box.appendChild(again);
      var out=mk("Chiqish");out.addEventListener("click",function(){if(onExit)onExit();});box.appendChild(out);
    }
    next();
  };
  var ad=document.getElementById("adq");
  function showStart(){
    ad.innerHTML="<h3>AI bilan moslashuvchan mashq</h3><p>Har safar yangi savollar. To‘g‘ri javob bersangiz savollar qiyinlashadi, xato qilsangiz osonlashadi. Xohlagancha davom eting.</p><label for='ad_s'>Fanni tanlang</label><select class='in' id='ad_s'></select><button class='btn' id='ad_go' type='button'>Mashqni boshlash</button>";
    var sel=document.getElementById("ad_s");
    Object.keys(window.SB||{}).forEach(function(k){var o=document.createElement("option");o.textContent=k;sel.appendChild(o);});
    document.getElementById("ad_go").addEventListener("click",function(){window.sinfPractice(ad,sel.value,2,null,showStart);});
  }
  if(ad)showStart();
})();
</script>
<script>
(function(){
  var JK="sinf_journal",KK="sinf_ktp",CK="sinf_classes",cur="",rows=[];
  function $(id){return document.getElementById(id)}
  function ld(k,d){try{var v=JSON.parse(localStorage.getItem(k)||"null");return v==null?d:v}catch(e){return d}}
  function sv(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
  function today(){var d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");}
  function fmt(d){return String(d).split("-").reverse().join(".")}
  function cell(tr,txt,tag){var c=document.createElement(tag||"td");if(txt!=null)c.textContent=txt;tr.appendChild(c);return c;}
  function head(t,arr){t.innerHTML="";var tr=document.createElement("tr");arr.forEach(function(x){cell(tr,x,"th")});t.appendChild(tr);}
  function jd(){var J=ld(JK,{});if(!J[cur])J[cur]={students:[],rec:{}};return J;}
  function renderJ(){
    var t=$("j_tbl");rows=[];head(t,["№","O‘quvchi","Keldi","Baho","O‘rtacha",""]);
    if(!cur)return;
    var C=jd()[cur],date=$("j_date").value||today(),r=C.rec[date]||{};
    if(!C.students.length){var e=document.createElement("tr");var c=cell(e,"Hozircha o‘quvchilar yo‘q. Yuqorida ism yozib qo‘shing.");c.colSpan=6;t.appendChild(e);return;}
    C.students.forEach(function(nm,i){
      var tr=document.createElement("tr");cell(tr,i+1);cell(tr,nm);
      var chk=document.createElement("input");chk.type="checkbox";chk.checked=r[nm]?r[nm].a!==0:true;chk.setAttribute("aria-label",nm+": keldi");cell(tr).appendChild(chk);
      var sel=document.createElement("select");sel.setAttribute("aria-label",nm+": baho");
      ["","2","3","4","5"].forEach(function(g){var o=document.createElement("option");o.value=g;o.textContent=g||"—";sel.appendChild(o);});
      sel.value=r[nm]&&r[nm].g?String(r[nm].g):"";cell(tr).appendChild(sel);
      var gs=[];Object.keys(C.rec).forEach(function(d){var x=C.rec[d][nm];if(x&&x.g)gs.push(x.g);});
      cell(tr,gs.length?(gs.reduce(function(a,b){return a+b},0)/gs.length).toFixed(1):"—");
      var del=document.createElement("button");del.type="button";del.className="xbtn";del.textContent="×";del.setAttribute("aria-label",nm+" ni o‘chirish");
      del.addEventListener("click",function(){var J=jd(),K=J[cur];K.students=K.students.filter(function(s){return s!==nm});Object.keys(K.rec).forEach(function(d){delete K.rec[d][nm]});sv(JK,J);renderJ();});
      cell(tr).appendChild(del);t.appendChild(tr);rows.push({nm:nm,chk:chk,sel:sel});
    });
  }
  function renderK(){
    var t=$("k_tbl");head(t,["№","Sana","Mavzu","Soat","Bajarildi",""]);
    var K=ld(KK,{}),arr=K[cur]||[];
    var sorted=arr.slice().sort(function(a,b){return a.d<b.d?-1:a.d>b.d?1:0});
    var done=0,hrs=0;
    function prog(){done=0;hrs=0;arr.forEach(function(x){hrs+=x.h;if(x.done)done++});var p=arr.length?Math.round(done/arr.length*100):0;$("k_bar").style.width=p+"%";$("k_prog").textContent=arr.length?("Bajarildi: "+done+" / "+arr.length+" dars ("+p+"%). Jami: "+hrs+" soat."):"Hozircha mavzular yo‘q.";}
    sorted.forEach(function(x,i){
      var tr=document.createElement("tr");cell(tr,i+1);cell(tr,fmt(x.d));cell(tr,x.t);cell(tr,x.h);
      var chk=document.createElement("input");chk.type="checkbox";chk.checked=!!x.done;chk.setAttribute("aria-label",x.t+": bajarildi");
      chk.addEventListener("change",function(){x.done=chk.checked;K[cur]=arr;sv(KK,K);prog();});cell(tr).appendChild(chk);
      var del=document.createElement("button");del.type="button";del.className="xbtn";del.textContent="×";del.setAttribute("aria-label",x.t+" ni o‘chirish");
      del.addEventListener("click",function(){arr.splice(arr.indexOf(x),1);K[cur]=arr;sv(KK,K);renderK();});
      cell(tr).appendChild(del);t.appendChild(tr);
    });
    prog();
  }
  function fillCls(){
    var s=$("j_cls"),a=ld(CK,[]),keep=s.value;if(!Array.isArray(a))a=[];s.innerHTML="";
    a.forEach(function(c){var o=document.createElement("option");o.value=c.code;o.textContent=c.name;s.appendChild(o);});
    if(keep&&a.some(function(c){return c.code===keep}))s.value=keep;
    cur=s.value;$("j_none").hidden=a.length>0;$("j_main").hidden=!a.length;s.hidden=!a.length;
    renderJ();renderK();
  }
  $("j_date").value=today();$("k_date").value=today();
  $("j_cls").addEventListener("change",function(){cur=this.value;renderJ();renderK();});
  $("j_date").addEventListener("change",renderJ);
  $("j_seg").addEventListener("click",function(e){var b=e.target.closest(".chip");if(!b)return;
    this.querySelectorAll(".chip").forEach(function(c){c.classList.toggle("on",c===b)});
    var j=b.getAttribute("data-tab")==="j";$("tab_j").hidden=!j;$("tab_k").hidden=j;});
  $("j_add").addEventListener("click",function(){
    var nm=$("j_new").value.trim();if(!nm||!cur){$("j_new").focus();return;}
    var J=jd(),C=J[cur];if(C.students.indexOf(nm)>=0||C.students.length>=40){$("j_msg").textContent=C.students.length>=40?"Eng ko‘pi bilan 40 ta o‘quvchi.":"Bu o‘quvchi ro‘yxatda bor.";return;}
    C.students.push(nm);sv(JK,J);$("j_new").value="";$("j_msg").textContent="";renderJ();
  });
  $("j_save").addEventListener("click",function(){
    if(!cur||!rows.length){$("j_msg").textContent="Avval o‘quvchi qo‘shing.";return;}
    var J=jd(),C=J[cur],date=$("j_date").value||today();C.rec[date]=C.rec[date]||{};
    rows.forEach(function(r){C.rec[date][r.nm]={a:r.chk.checked?1:0,g:r.sel.value?Number(r.sel.value):null};});
    sv(JK,J);$("j_msg").textContent="Saqlandi: "+fmt(date);renderJ();
  });
  $("k_add").addEventListener("click",function(){
    var t=$("k_t").value.trim(),d=$("k_date").value||today(),h=Math.max(1,Math.min(4,parseInt($("k_h").value,10)||1));
    if(!cur)return;if(!t){$("k_msg").textContent="Dars mavzusini yozing.";$("k_t").focus();return;}
    $("k_msg").textContent="";var K=ld(KK,{});K[cur]=K[cur]||[];if(K[cur].length>=200){$("k_msg").textContent="Juda ko‘p mavzu.";return;}
    K[cur].push({d:d,t:t,h:h,done:false});sv(KK,K);$("k_t").value="";renderK();
  });
  window.addEventListener("hashchange",function(){if(location.hash==="#jurnal")fillCls();});
  fillCls();
})();
</script>
<script>
(function(){
  var UK="sinf_users",SK="sinf_session";
  function $(id){return document.getElementById(id)}
  function ld(k,d){try{var v=JSON.parse(localStorage.getItem(k)||"null");return v==null?d:v}catch(e){return d}}
  function sv(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
  function b64e(a){var s="";for(var i=0;i<a.length;i++)s+=String.fromCharCode(a[i]);return btoa(s)}
  function b64d(s){var b=atob(s),a=new Uint8Array(b.length);for(var i=0;i<b.length;i++)a[i]=b.charCodeAt(i);return a}
  function canHash(){return !!(window.crypto&&crypto.subtle&&window.TextEncoder)}
  function hash(pw,salt){return crypto.subtle.importKey("raw",new TextEncoder().encode(pw),"PBKDF2",false,["deriveBits"]).then(function(k){return crypto.subtle.deriveBits({name:"PBKDF2",salt:b64d(salt),iterations:150000,hash:"SHA-256"},k,256)}).then(function(bits){return b64e(new Uint8Array(bits))});}
  var tgo=$("tgo"),msg=$("tmsg");
  function proceed(name){window.sinfRegTeacher&&window.sinfRegTeacher(name);
    if($("trem").checked)sv(SK,{n:name.toLowerCase()});else{try{localStorage.removeItem(SK)}catch(e){}}
    tgo.dataset.ok="1";tgo.dataset.skip="1";tgo.click();
  }
  function check(){
    var name=$("tn").value.trim(),pw=$("tp").value;
    if(!name){$("tn").focus();return null;}
    if(pw.length<6){msg.textContent="Parol kamida 6 ta belgidan iborat bo‘lsin.";$("tp").focus();return null;}
    msg.textContent="";return {name:name,pw:pw};
  }
  tgo.addEventListener("click",function(e){
    if(tgo.dataset.ok){delete tgo.dataset.ok;setTimeout(function(){delete tgo.dataset.skip},0);return;}
    e.stopImmediatePropagation();e.preventDefault();
    var v=check();if(!v)return;
    if(!$("tsub").value){msg.textContent="Dars beradigan fanni tanlang.";$("tsub").focus();return;}
    var U=ld(UK,{}),key=v.name.toLowerCase();
    if(U[key]){msg.textContent="Bu ism bilan hisob bor. “Kirish” tugmasini bosing.";return;}
    if(Object.keys(U).length>=50){msg.textContent="Hisoblar soni to‘ldi.";return;}
    if(!canHash()){proceed(v.name);return;}
    var salt=b64e(crypto.getRandomValues(new Uint8Array(16)));
    hash(v.pw,salt).then(function(h){U[key]={n:v.name,s:salt,h:h};sv(UK,U);proceed(v.name);}).catch(function(){msg.textContent="Hisobni saqlab bo‘lmadi.";});
  },true);
  $("tlogin").addEventListener("click",function(){
    var v=check();if(!v)return;
    var u=ld(UK,{})[v.name.toLowerCase()];
    if(!u){msg.textContent="Bunday hisob topilmadi. Avval “Hisob yaratish” tugmasini bosing.";return;}
    if(!canHash()){msg.textContent="Brauzer parolni tekshira olmaydi.";return;}
    hash(v.pw,u.s).then(function(h){if(h===u.h){$("tn").value=u.n;proceed(u.n);}else{msg.textContent="Parol noto‘g‘ri.";}}).catch(function(){msg.textContent="Tekshirib bo‘lmadi.";});
  });
  var lo0=window.sinfLogout;
  window.sinfLogout=function(){try{localStorage.removeItem(SK)}catch(e){}if(lo0)lo0();};
  var ss=ld(SK,null),U0=ld(UK,{});
  if(ss&&ss.n&&U0[ss.n]){$("tn").value=U0[ss.n].n;tgo.dataset.ok="1";tgo.dataset.skip="1";tgo.click();}
})();
</script>
<script>
(function(){
  var TK2="sinf_teachers";
  function $(id){return document.getElementById(id)}
  function ld(k,d){try{var v=JSON.parse(localStorage.getItem(k)||"null");return v==null?d:v}catch(e){return d}}
  function sv(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
  var sel=$("tsub"),o0=document.createElement("option");o0.value="";o0.textContent="Fanni tanlang";sel.appendChild(o0);
  Object.keys(window.SB||{}).forEach(function(k){var o=document.createElement("option");o.value=k;o.textContent=k;sel.appendChild(o);});
  window.sinfRegTeacher=function(name){
    var v=$("tsub").value,T=ld(TK2,{}),k=name.toLowerCase();
    if(v){T[k]={n:name,s:v};sv(TK2,T);try{localStorage.setItem("sinf_teacher_subj",v)}catch(e){}}
    else if(T[k]){try{localStorage.setItem("sinf_teacher_subj",T[k].s)}catch(e){}}
  };
  var old=window.sinfTeacher;
  window.sinfTeacher=function(dash,name){
    if(old)old(dash,name);
    var b=$("tc_save");
    if(b)b.addEventListener("click",function(){var v=$("tc_subj").value;if(!v)return;var T=ld(TK2,{});T[name.toLowerCase()]={n:name,s:v};sv(TK2,T);});
  };
  var D={
    "Ona tili":"O‘zbek tilining imlosi, so‘z turkumlari va gap tuzilishini o‘rgatadi.",
    "Adabiyot":"Navoiy, Bobur, Qodiriy kabi ijodkorlarning asarlari bilan tanishtiradi.",
    "Matematika":"Sonlar, amallar va masalalar yechish ko‘nikmasini shakllantiradi.",
    "Algebra":"Tenglamalar, ifodalar va formulalar bilan ishlashni o‘rgatadi.",
    "Geometriya":"Shakllar, burchaklar, yuz va hajm haqida bilim beradi.",
    "Fizika":"Tabiat hodisalari, kuch, harakat va energiya qonunlarini tushuntiradi.",
    "Kimyo":"Moddalar, elementlar va ularning o‘zgarishlarini o‘rgatadi.",
    "Biologiya":"Tirik organizmlar, hujayra va inson tanasi haqida.",
    "Geografiya":"Yer, qit’alar, iqlim va O‘zbekiston tabiatini o‘rgatadi.",
    "O‘zbekiston tarixi":"Ajdodlarimiz, buyuk davlatlar va mustaqillik yo‘lini o‘rgatadi.",
    "Jahon tarixi":"Qadimgi sivilizatsiyalardan hozirgi zamongacha dunyo tarixi.",
    "Ingliz tili":"So‘z boyligi, grammatika, o‘qish va suhbat ko‘nikmalarini rivojlantiradi.",
    "Rus tili":"Rus tilida o‘qish, yozish va muloqot qilishni o‘rgatadi.",
    "Informatika":"Kompyuter, internet, dasturlash asoslari va ma’lumotlar bilan ishlash.",
    "Tasviriy san’at":"Ranglar, chizish va san’at asarlarini tushunishni o‘rgatadi.",
    "Musiqa":"Notalar, cholg‘u asboblari va xalq kuylari bilan tanishtiradi.",
    "Jismoniy tarbiya":"Sog‘lom turmush, sport o‘yinlari va mashqlarni o‘rgatadi.",
    "Texnologiya":"Mehnat ko‘nikmalari, materiallar bilan ishlash va xavfsizlik qoidalari."
  };
  function reg(){
    var U=ld("sinf_users",{}),T=ld(TK2,{}),g="";try{g=localStorage.getItem("sinf_teacher_subj")||""}catch(e){}
    var out=[],missing=[];
    Object.keys(U).forEach(function(k){var r=T[k];if(r&&r.s)out.push({n:U[k].n||r.n,s:r.s});else missing.push(k);});
    if(g&&missing.length===1){var k=missing[0];T[k]={n:U[k].n,s:g};sv(TK2,T);out.push({n:U[k].n,s:g});}
    Object.keys(T).forEach(function(k){if(!U[k]&&T[k].s)out.push({n:T[k].n,s:T[k].s});});
    return out;
  }
  var lis=document.querySelectorAll(".subjects li");
  function refresh(){var R=reg();lis.forEach(function(li){var s=li.dataset.s||li.textContent.trim();li.dataset.s=s;var c=R.filter(function(t){return t.s===s}).length;li.textContent=s;if(c){var b=document.createElement("span");b.className="cnt";b.textContent=c;li.appendChild(b);}});}
  function show(li){
    lis.forEach(function(x){x.classList.toggle("on",x===li)});
    var s=li.dataset.s||li.textContent.trim(),box=$("sbox");box.hidden=false;
    $("s_t").textContent=s;$("s_d").textContent=D[s]||"Platformaga yangi fanlar muntazam qo‘shilib boradi.";
    var list=reg().filter(function(t){return t.s===s});
    var L=$("s_l");L.innerHTML="";
    if(!list.length){L.textContent="Hozircha bu fan bo‘yicha o‘qituvchi ro‘yxatdan o‘tmagan.";return;}
    list.forEach(function(t){
      var d=document.createElement("div");d.className="tcard";
      var a=document.createElement("div");a.className="tav";a.textContent=t.n.trim().charAt(0).toUpperCase();
      var n=document.createElement("div"),b=document.createElement("b"),sm=document.createElement("div");
      b.textContent=t.n;sm.style.color="var(--muted)";sm.textContent=s+" o‘qituvchisi";
      n.appendChild(b);n.appendChild(sm);d.appendChild(a);d.appendChild(n);L.appendChild(d);
    });
  }
  refresh();window.addEventListener("hashchange",function(){if(location.hash==="#fanlar")refresh();});
  lis.forEach(function(li){li.tabIndex=0;li.setAttribute("role","button");
    li.addEventListener("click",function(){show(li)});
    li.addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();show(li)}});});
})();
</script>
<script>
(function(){
  var box=document.querySelector(".wheel-box"),b=document.getElementById("bigb"),x=document.getElementById("bigx");
  function set(on){box.classList.toggle("big",on);document.body.style.overflow=on?"hidden":"";(on?document.getElementById("spin"):b).focus();}
  b.addEventListener("click",function(){set(true)});
  x.addEventListener("click",function(){set(false)});
  document.addEventListener("keydown",function(e){if(e.key==="Escape"&&box.classList.contains("big"))set(false);});
})();
</script>
<script>
(function(){
  function $(id){return document.getElementById(id)}
  $("navout").addEventListener("click",function(){
    var d=$("dash"),ft=$("f-t"),fs=$("f-s"),chip=document.querySelector("#authbox .seg .chip.on"),t=!chip||chip.getAttribute("data-role")==="t";
    d.hidden=true;d.innerHTML="";ft.hidden=!t;fs.hidden=t;
    document.querySelector('nav a[href="#kirish"]').hidden=false;
    if(window.sinfLogout)window.sinfLogout();
  });
})();
</script>
<script>
(function(){
  var io=null;
  if("IntersectionObserver" in window)io=new IntersectionObserver(function(es){var k=0;es.forEach(function(e){if(e.isIntersecting){e.target.style.transitionDelay=(k++*0.5)+"s";e.target.classList.add("in");io.unobserve(e.target);}})},{threshold:.1,rootMargin:"0px 0px -12% 0px"});
  function setup(){
    if(!io)return;
    [].slice.call(document.querySelectorAll(".page.on")).forEach(function(s,i){
      if(i===0||s.dataset.rv)return;
      s.dataset.rv="1";s.classList.add("rv");io.observe(s);
    });
  }
  window.addEventListener("hashchange",function(){setTimeout(setup,0)});
  setup();
})();
</script>
<script>
(function(){
  var D={
"Bosh sahifa":["Главная","Home"],"Muammo va yechim":["Проблема и решение","Problem & solution"],"Uy vazifalari":["Домашние задания","Homework"],"Fanlar va Emaktab":["Предметы и Emaktab","Subjects & Emaktab"],"Bog‘lanish":["Контакты","Contact"],"Jurnal va KTP":["Журнал и КТП","Journal & lesson plan"],"Shaxsiy kabinet":["Личный кабинет","My account"],"Kirish":["Войти","Sign in"],"Chiqish":["Выйти","Sign out"],
"O‘zbekiston ta’limida yangi interaktiv davr":["Новая интерактивная эра в образовании Узбекистана","A new interactive era in Uzbek education"],
"O‘qituvchilar uchun darsda smartfonlarsiz o‘quvchilar diqqatini 100% qaytaradigan yagona raqamli ekotizim.":["Единая цифровая экосистема, которая возвращает 100% внимания учеников на уроке без смартфонов.","One digital ecosystem that brings students’ full attention back in class, without smartphones."],
"Qanday ishlaydi":["Как это работает","How it works"],"Aylantirish":["Крутить","Spin"],"Yana aylantirish":["Крутить ещё","Spin again"],"Ismlarni yozish":["Ввести имена","Enter names"],"Kattalashtirish":["Увеличить","Enlarge"],"Ismlarni yozing":["Введите имена","Enter the names"],"Ro‘yxatni qo‘llash":["Применить список","Apply list"],
"Avval “Ismlarni yozish” tugmasini bosib, o‘quvchilar ismlarini kiriting.":["Сначала нажмите «Ввести имена» и впишите имена учеников.","First press “Enter names” and type the students’ names."],
"Kim uchun?":["Для кого?","Who is it for?"],"O‘qituvchilar uchun":["Для учителей","For teachers"],"O‘quvchilar uchun":["Для учеников","For students"],
"Ballar Emaktab elektron jurnaliga avtomatik o‘tadi":["Баллы автоматически попадают в электронный журнал Emaktab","Scores go to the Emaktab e-journal automatically"],"Vaqtni 5 baravargacha tejaydi":["Экономит до 5 раз времени","Saves up to 5 times the time"],"Har bir fan bo‘yicha tayyor interaktiv ssenariy":["Готовый интерактивный сценарий по каждому предмету","A ready interactive scenario for every subject"],
"Doskada jonli o‘yinlar va bahslar":["Живые игры и диспуты на доске","Live games and debates on the board"],"Omad shousi: har kim ishtirok etadi":["Шоу удачи: участвуют все","Lucky show: everyone takes part"],"Uy vazifasi: 10 daqiqalik yorqin kvest":["Домашнее задание: яркий 10-минутный квест","Homework: a bright 10-minute quest"],
"Sinf.uz bo‘limlari":["Разделы Sinf.uz","Sinf.uz sections"],"Bo‘limni tanlang va platformani birma-bir ko‘rib chiqing.":["Выберите раздел и изучите платформу шаг за шагом.","Pick a section and explore the platform step by step."],
"Nega smartfonlar darsga xalaqit beradi va Sinf.uz buni qanday hal qiladi.":["Почему смартфоны мешают уроку и как Sinf.uz это решает.","Why smartphones disturb lessons and how Sinf.uz solves it."],"Sinfda tahlil qilish yoki uyda avtomatik tekshirish: ikki variant.":["Разбор в классе или автопроверка дома: два варианта.","Review in class or automatic checking at home: two options."],"Barcha fanlar, elektron jurnal bilan sinxronizatsiya va yangilanadigan kontent.":["Все предметы, синхронизация с электронным журналом и обновляемый контент.","All subjects, e-journal sync and always up-to-date content."],"Maktabingizda Sinf.uz ni sinab ko‘rish uchun yozing.":["Напишите, чтобы попробовать Sinf.uz в вашей школе.","Write to us to try Sinf.uz at your school."],
"Maktablarning eng katta dushmani":["Главный враг школ","The biggest enemy of schools"],"Smartfon":["Смартфон","Smartphone"],"Sinfda haqiqiy “magiya” boshlanadi":["В классе начинается настоящее волшебство","Real magic starts in the classroom"],"Kitob":["Книга","Book"],"Interaktiv o‘yin":["Интерактивная игра","Interactive game"],"Jonli bahs":["Живой диспут","Live debate"],"Omad shousi":["Шоу удачи","Lucky show"],
"Uy vazifalari: sinfda va uyda":["Домашние задания: в классе и дома","Homework: in class and at home"],"A varianti: Sinfda interaktiv tahlil":["Вариант A: интерактивный разбор в классе","Option A: interactive review in class"],"B varianti: Uyda aqlli avtomatika":["Вариант B: умная автоматика дома","Option B: smart automation at home"],
"Butun maktab uchun yagona raqamli yurak":["Единое цифровое сердце для всей школы","One digital heart for the whole school"],
"Ona tili":["Родной язык","Uzbek language"],"Adabiyot":["Литература","Literature"],"Matematika":["Математика","Mathematics"],"Algebra":["Алгебра","Algebra"],"Geometriya":["Геометрия","Geometry"],"Fizika":["Физика","Physics"],"Kimyo":["Химия","Chemistry"],"Biologiya":["Биология","Biology"],"Geografiya":["География","Geography"],"O‘zbekiston tarixi":["История Узбекистана","History of Uzbekistan"],"Jahon tarixi":["Всемирная история","World history"],"Ingliz tili":["Английский язык","English"],"Rus tili":["Русский язык","Russian"],"Informatika":["Информатика","Computer science"],"Tasviriy san’at":["Изобразительное искусство","Art"],"Musiqa":["Музыка","Music"],"Jismoniy tarbiya":["Физкультура","Physical education"],"Texnologiya":["Технология","Technology"],"va yana ko‘plab fanlar":["и многие другие предметы","and many more subjects"],"Ro‘yxatdan o‘tgan o‘qituvchilar":["Зарегистрированные учителя","Registered teachers"],
"Sinf.uz ga kirish":["Вход в Sinf.uz","Sign in to Sinf.uz"],"Hisob yarating va platformani sinab ko‘ring. O‘qituvchi hisobi (ism va parol) shu brauzerda saqlanadi.":["Создайте аккаунт и попробуйте платформу. Аккаунт учителя (имя и пароль) сохраняется в этом браузере.","Create an account and try the platform. The teacher account (name and password) is saved in this browser."],"O‘qituvchi":["Учитель","Teacher"],"O‘quvchi":["Ученик","Student"],"Ismingiz":["Ваше имя","Your name"],"Parol":["Пароль","Password"],"Dars beradigan fan":["Предмет, который вы преподаёте","Subject you teach"],"Meni eslab qol":["Запомнить меня","Remember me"],"Hisob yaratish":["Создать аккаунт","Create account"],"Ism yoki laqab":["Имя или ник","Name or nickname"],"Sinf kodi":["Код класса","Class code"],"Sinfga qo‘shilish":["Присоединиться к классу","Join the class"],"Emaktab orqali kirish: tez orada":["Вход через Emaktab: скоро","Sign in with Emaktab: coming soon"],"Emaktab orqali kirish":["Вход через Emaktab","Sign in with Emaktab"],
"Maktablarimizga yangi nafas olib kiraylik":["Давайте вдохнём новую жизнь в школы","Let’s breathe new life into our schools"],"Emaktab ekotizimi bilan hamkorlikda O‘zbekiston ta’limini birgalikda o‘zgartiramiz.":["Вместе с экосистемой Emaktab мы изменим образование Узбекистана.","Together with the Emaktab ecosystem, we will transform Uzbek education."],"Maktabingizda sinab ko‘ring":["Попробуйте в вашей школе","Try it at your school"],"Maktab va sinf":["Школа и класс","School and class"],"Xabaringiz":["Ваше сообщение","Your message"],"Xabar yuborish":["Отправить","Send message"],"Telefon":["Телефон","Phone"],"Veb-sayt":["Сайт","Website"],"Tugatish":["Завершить","Finish"],"Keyingi savol":["Следующий вопрос","Next question"],
"O‘zbekiston ta’limida yangi davr.":["новая эра образования Узбекистана.","a new era of Uzbek education."],
"Tugma pochta ilovangizni tayyor xat bilan ochadi.":["Кнопка откроет вашу почтовую программу с готовым письмом.","The button opens your email app with a ready message."],
"Darsda telefon kerakmi?":["Нужен ли телефон на уроке?","Are phones needed in class?"],
"Yo‘q. A varianti bo‘yicha bolalar daftarga yozadi, qiyin savollar esa doskada o‘yin shaklida yechiladi.":["Нет. По варианту A дети пишут в тетради, а сложные вопросы решаются на доске в форме игры.","No. In option A children write in notebooks, and the hard questions are solved on the board as a game."],
"Qaysi fanlar bor?":["Какие есть предметы?","Which subjects are there?"],
"Matematika, Fizika, Tarix, Ingliz tili va maktab dasturidagi boshqa barcha fanlar.":["Математика, физика, история, английский язык и все остальные предметы школьной программы.","Mathematics, physics, history, English and all other subjects of the school curriculum."],
"Emaktab bilan ishlaydimi?":["Работает ли это с Emaktab?","Does it work with Emaktab?"],
"Sinf.uz Emaktab elektron jurnali bilan sinxronizatsiya qilish uchun yaratilmoqda. Hozircha o‘z hisobingiz bilan boshlashingiz mumkin.":["Sinf.uz создаётся для синхронизации с электронным журналом Emaktab. Пока можно начать со своим аккаунтом.","Sinf.uz is being built to sync with the Emaktab e-journal. For now you can start with your own account."],
"Kontent qachon yangilanadi?":["Когда обновляется контент?","When is the content updated?"],
"Har yili 25-avgustga qadar barcha yangi darsliklar tizimga qo‘shiladi.":["Ежегодно до 25 августа все новые учебники добавляются в систему.","Every year, all new textbooks are added to the system by August 25."],
"Masalan: 9-maktab, 7-sinf":["Например: школа № 9, 7 класс","For example: School 9, grade 7"],
"Qaysi fan yoki sinf uchun qiziqyapsiz?":["Какой предмет или класс вас интересует?","Which subject or class are you interested in?"],
"Masalan: Dilnoza Karimova":["Например: Дилноза Каримова","For example: Dilnoza Karimova"],
"Kamida 6 ta belgi":["Не менее 6 символов","At least 6 characters"],
"Masalan: 7B":["Например: 7B","For example: 7B"],
"Ism familiya":["Имя и фамилия","Full name"],
"Biz maktab darslarini bolalar uchun jismoniy tarbiya darsi kabi intiqlik bilan kutiladigan, smartfon o‘yinlaridan ko‘ra qiziqarliroq":["Мы превращаем школьные уроки в событие, которого дети ждут так же, как урока физкультуры, и которое интереснее игр на смартфоне: в","We turn school lessons into a much-awaited event, as exciting as PE class and more fun than smartphone games: an"],
"interaktiv shouga":["интерактивное шоу.","interactive show."],
"aylantiramiz.":["",""],
"Sinf.uz oddiy sinf xonasini jonli o‘yin maydoniga aylantiradi. O‘qituvchi interaktiv doskani yoqadi va butun sinf darsga sho‘ng‘iydi. Telefonlar o‘z-o‘zidan unutiladi, chunki doskadagi voqealar smartfondan kuchliroq jozibaga ega.":["Sinf.uz превращает обычный класс в живую игровую площадку. Учитель включает интерактивную доску, и весь класс погружается в урок. Телефоны забываются сами собой, ведь события на доске притягивают сильнее смартфона.","Sinf.uz turns an ordinary classroom into a live game arena. The teacher switches on the interactive board and the whole class dives into the lesson. Phones are forgotten by themselves, because what happens on the board is more captivating than a smartphone."],
"Faoliyat har 7 daqiqada almashadi. Aylanadigan tasodifiy tanlov (Randomizer) har bir bolani hayajonda ushlab turadi. Diqqat 100% doskada va darslikda.":["Занятия меняются каждые 7 минут. Вращающийся случайный выбор (рандомайзер) держит каждого ребёнка в азарте. Внимание на 100% на доске и в учебнике.","The activity changes every 7 minutes. The spinning random picker (Randomizer) keeps every child excited. Attention is 100% on the board and the textbook."],
"Sinfning diqqati qayerda?":["Где внимание класса?","Where is the class’s attention?"],
"Faqat ma’ruza va qog‘oz darslik: bolalarning fikri telefonda.":["Только лекция и бумажный учебник: мысли детей в телефоне.","Only lectures and paper textbooks: the children’s minds are on their phones."],
"Interaktiv doskani yoqish":["Включить интерактивную доску","Switch on the interactive board"],
"Oddiy darsga qaytish":["Вернуться к обычному уроку","Back to a normal lesson"],
"Doskada o‘yin ketmoqda: diqqat 100% doskada va darslikda.":["На доске идёт игра: внимание на 100% на доске и в учебнике.","A game is on the board: attention is 100% on the board and the textbook."],
"Darsda telefonlar taqiqlangan bo‘lsa ham, klassik ma’ruzalar va qog‘oz darsliklar bolalarni jalb qila olmayapti.":["Даже если телефоны на уроках запрещены, классические лекции и бумажные учебники не увлекают детей.","Even though phones are banned in class, classic lectures and paper textbooks fail to engage children."],
"O‘qituvchilar dars o‘tish o‘rniga intizom uchun kurashishga va daftarlarni qo‘lda tekshirishga soatlab vaqt yo‘qotmoqda.":["Вместо того чтобы вести урок, учителя часами борются за дисциплину и вручную проверяют тетради.","Instead of teaching, teachers lose hours fighting for discipline and checking notebooks by hand."],
"Ikki variant: o‘qituvchi o‘z sinfiga mosini tanlaydi.":["Два варианта: учитель выбирает подходящий для своего класса.","Two options: the teacher picks the one that suits their class."],
"A varianti":["Вариант A","Option A"],"B varianti":["Вариант B","Option B"],"Sinfda interaktiv tahlil":["Интерактивный разбор в классе","Interactive review in class"],"Uyda aqlli avtomatika":["Умная автоматика дома","Smart automation at home"],
"Bolalar uy vazifasini odatdagidek daftarga bajaradi. Telefon mutlaqo kerak emas. Keyingi darsda tizim eng ko‘p xato qilingan qiyin savollarni doskaga chiqaradi va sinf bo‘lib uni o‘yin shaklida yechadi.":["Дети делают домашнее задание в тетради, как обычно. Телефон совсем не нужен. На следующем уроке система выводит на доску самые трудные вопросы с наибольшим числом ошибок, и класс решает их вместе в форме игры.","Children do their homework in notebooks as usual. No phone is needed at all. In the next lesson the system puts the hardest, most-missed questions on the board and the class solves them together as a game."],
"O‘quvchi uyda ota-onasining telefoni yoki kompyuteridan kiradi. Vazifa zerikarli test emas, 10 daqiqalik yorqin kvest. Tizim hamma narsani o‘zi tekshiradi va bahoni o‘qituvchiga yuboradi.":["Ученик заходит дома с телефона или компьютера родителей. Задание — не скучный тест, а яркий 10-минутный квест. Система всё проверяет сама и отправляет оценку учителю.","The student logs in at home from a parent’s phone or computer. The task isn’t a boring test but a bright 10-minute quest. The system checks everything itself and sends the grade to the teacher."],
"Daftarga yozish":["Запись в тетрадь","Write in the notebook"],"Eng ko‘p xato qilingan savollarni topish":["Поиск вопросов с наибольшим числом ошибок","Find the most-missed questions"],"Doskada o‘yin shaklida yechish":["Решение на доске в форме игры","Solve it on the board as a game"],"10 daqiqalik kvest":["10-минутный квест","10-minute quest"],"Avtomatik tekshirish":["Автоматическая проверка","Automatic checking"],"Baho o‘qituvchiga yuboriladi":["Оценка отправляется учителю","The grade is sent to the teacher"],
"AI bilan moslashuvchan mashq":["Адаптивная практика с ИИ","Adaptive practice with AI"],
"Har safar yangi savollar. To‘g‘ri javob bersangiz savollar qiyinlashadi, xato qilsangiz osonlashadi. Xohlagancha davom eting.":["Каждый раз новые вопросы. Ответите верно — вопросы станут сложнее, ошибётесь — легче. Продолжайте сколько хотите.","New questions every time. Answer correctly and they get harder; make a mistake and they get easier. Keep going as long as you like."],
"Fanni tanlang":["Выберите предмет","Choose a subject"],"Mashqni boshlash":["Начать практику","Start practice"],"Savol tayyorlanmoqda…":["Готовим вопрос…","Preparing a question…"],"Keyingi savol →":["Следующий вопрос →","Next question →"],"To‘g‘ri!":["Верно!","Correct!"],"Xato. Keyingi savol osonroq bo‘ladi.":["Ошибка. Следующий вопрос будет легче.","Wrong. The next question will be easier."],"Barakalla! Keyingi savol qiyinroq bo‘ladi.":["Молодец! Следующий вопрос будет сложнее.","Well done! The next question will be harder."],"Yana mashq":["Ещё практика","More practice"],
"AI hozir mavjud emas: tayyor savollar bazasidan foydalanilmoqda.":["ИИ сейчас недоступен: используется готовая база вопросов.","AI is unavailable right now: using the ready-made question bank."],
"Juda oson":["Очень лёгкий","Very easy"],"Oson":["Лёгкий","Easy"],"O‘rta":["Средний","Medium"],"Qiyin":["Сложный","Hard"],"Juda qiyin":["Очень сложный","Very hard"],
"Sinf.uz bitta fan emas, O‘zbekiston maktab dasturidagi barcha fanlarni to‘liq qamrab oladi. Har bir o‘qituvchi o‘z fani bo‘yicha tayyor interaktiv ssenariyga ega bo‘ladi.":["Sinf.uz — это не один предмет, а все предметы школьной программы Узбекистана. У каждого учителя будет готовый интерактивный сценарий по его предмету.","Sinf.uz isn’t just one subject: it covers every subject in Uzbekistan’s school curriculum. Every teacher gets a ready interactive scenario for their subject."],
"tezroq":["быстрее","faster"],"Emaktab (Kundalik) bilan to‘liq sinxronizatsiya":["Полная синхронизация с Emaktab (Kundalik)","Full sync with Emaktab (Kundalik)"],
"O‘qituvchi ortiqcha qog‘ozbozlik qilmaydi. Interaktiv o‘yinlar va aqlli uy vazifalaridan olingan ballar avtomatik ravishda Emaktab elektron jurnaliga o‘tadi. Bu o‘qituvchining vaqtini 5 baravargacha tejaydi.":["Учителю не нужна лишняя бумажная работа. Баллы из интерактивных игр и умных домашних заданий автоматически попадают в электронный журнал Emaktab. Это экономит время учителя до 5 раз.","Teachers skip the extra paperwork. Scores from interactive games and smart homework go to the Emaktab e-journal automatically. This saves the teacher up to 5 times the time."],
"Haftasiga daftar tekshirishga ketadigan soat:":["Часов в неделю на проверку тетрадей:","Hours per week spent checking notebooks:"],
"Kontent hech qachon eskirmaydi":["Контент никогда не устаревает","The content never gets outdated"],
"Vazirlik darslikni yangilasa, Sinf.uz birinchi bo‘lib kontentni yangilaydi. Sun’iy intellekt (AI) texnologiyalari va kuchli metodistlar jamoasi yordamida har yili 25-avgustga qadar barcha yangi kitoblar tizimga integratsiya qilinadi.":["Если министерство обновляет учебник, Sinf.uz первым обновляет контент. С помощью технологий искусственного интеллекта (ИИ) и сильной команды методистов все новые книги ежегодно до 25 августа интегрируются в систему.","When the ministry updates a textbook, Sinf.uz is the first to update its content. With AI technologies and a strong team of methodologists, all new books are integrated into the system every year by August 25."],
"Hozircha bu fan bo‘yicha o‘qituvchi ro‘yxatdan o‘tmagan.":["По этому предмету пока нет зарегистрированных учителей.","No teacher has registered for this subject yet."],
"Platformaga yangi fanlar muntazam qo‘shilib boradi.":["На платформу регулярно добавляются новые предметы.","New subjects are added to the platform regularly."]
  };
  var P=[[/^Xush kelibsiz, (.+)$/,"Добро пожаловать, $1","Welcome, $1"],[/^Salom, (.+)!$/,"Привет, $1!","Hello, $1!"],[/^(.+) o‘qituvchisi$/,"Учитель: $1","$1 teacher"],[/^Taxminan (\d+) soat bo‘sh vaqt: bu “5 baravargacha” tejash hisobi\.$/,"Примерно $1 ч свободного времени: это расчёт экономии «до 5 раз».","About $1 hours of free time: this is the “up to 5 times” saving."]];
  var SK=Object.keys(D).sort(function(a,b){return b.length-a.length}),lang="uz",orig=new WeakMap(),busy=false,T0=document.title;
  try{lang=localStorage.getItem("sinf_lang")||"uz"}catch(e){}
  function t(s){
    if(lang==="uz")return s;var i=lang==="ru"?0:1;
    var tr=s.trim(),pre=tr.match(/^[^\p{L}\p{N}]*/u)[0],core=tr.slice(pre.length);
    if(D[core])return s.replace(core,D[core][i]);
    for(var a=0;a<SK.length;a++){var k=SK[a];if(k.length>=30&&s.indexOf(k)>=0)return s.replace(k,D[k][i]);}
    var q=s.match(/^(.+) · Daraja (\d): (.+) · Savol (\d+)$/);
    if(q){var g=function(x){return D[x]?D[x][i]:x};return g(q[1])+" · "+(i?"Level ":"Уровень ")+q[2]+": "+g(q[3])+" · "+(i?"Question ":"Вопрос ")+q[4];}
    for(var j=0;j<P.length;j++){if(P[j][0].test(s))return s.replace(P[j][0],function(m,a){var d=D[a];return P[j][i+1].replace("$1",d?d[i]:a)});}
    return s;
  }
  function apply(n){var r=orig.get(n);if(!r||n.nodeValue!==r.c){r={o:n.nodeValue,c:null};orig.set(n,r);}var v=t(r.o);r.c=v;if(n.nodeValue!==v)n.nodeValue=v;}
  function walk(root){
    if(root.nodeType===3){apply(root);return;}
    if(root.nodeType!==1||/^(SCRIPT|STYLE)$/.test(root.tagName))return;
    var w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT),x,list=[];
    while((x=w.nextNode()))list.push(x);list.forEach(apply);
    document.querySelectorAll("[placeholder]").forEach(function(e){if(e.dataset.ph0===undefined)e.dataset.ph0=e.getAttribute("placeholder");e.setAttribute("placeholder",t(e.dataset.ph0));});
  }
  function setLang(l){
    busy=true;lang=l;try{localStorage.setItem("sinf_lang",l)}catch(e){}
    document.documentElement.lang=l;walk(document.body);document.title=t(T0);
    document.querySelectorAll(".lang button").forEach(function(b){b.classList.toggle("on",b.getAttribute("data-l")===l)});
    setTimeout(function(){busy=false},0);
  }
  document.querySelectorAll(".lang button").forEach(function(b){b.addEventListener("click",function(){setLang(b.getAttribute("data-l"))})});
  new MutationObserver(function(ms){
    if(busy)return;busy=true;
    ms.forEach(function(m){m.addedNodes.forEach(walk);if(m.type==="characterData")apply(m.target);});
    setTimeout(function(){busy=false},0);
  }).observe(document.body,{childList:true,subtree:true,characterData:true});
  setLang(lang);
})();
</script>
<script>
(function(){
  var RK="sinf_results";
  function $(id){return document.getElementById(id)}
  function ld(k,d){try{var v=JSON.parse(localStorage.getItem(k)||"null");return v==null?d:v}catch(e){return d}}
  function sv(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
  window.sinfLog=function(r){
    var w=window.sinfWho;if(!w||w.role!=="O‘quvchi")return;
    var A=ld(RK,[]);A.push({q:r.q,ok:!!r.ok,s:r.s,l:r.l,n:w.name,c:w.code||"",t:Date.now()});
    if(A.length>2000)A=A.slice(-2000);sv(RK,A);
  };
  function fillCls(){
    var s=$("r_cls"),keep=s.value,a=ld("sinf_classes",[]);s.innerHTML="";
    var o0=document.createElement("option");o0.value="";o0.textContent="Barcha sinflar";s.appendChild(o0);
    a.forEach(function(c){var o=document.createElement("option");o.value=c.code;o.textContent=c.name;s.appendChild(o);});
    s.value=keep;if(s.value!==keep)s.value="";
  }
  function render(){
    var A=ld(RK,[]),c=$("r_cls").value;if(c)A=A.filter(function(x){return x.c===c});
    var ok=A.filter(function(x){return x.ok}).length,names={},qs={};
    A.forEach(function(x){
      var n=names[x.n]=names[x.n]||{c:0,ok:0,l:0};n.c++;if(x.ok)n.ok++;n.l+=x.l||0;
      var q=qs[x.q]=qs[x.q]||{c:0,w:0};q.c++;if(!x.ok)q.w++;
    });
    $("r_a").textContent=A.length;$("r_p").textContent=(A.length?Math.round(ok/A.length*100):0)+"%";$("r_s").textContent=Object.keys(names).length;
    var H=$("r_h");H.innerHTML="";
    var hard=Object.keys(qs).filter(function(k){return qs[k].w>0}).sort(function(a,b){return qs[b].w/qs[b].c-qs[a].w/qs[a].c||qs[b].c-qs[a].c}).slice(0,5);
    if(!hard.length)H.textContent=A.length?"Hozircha xato javoblar yo‘q.":"Hozircha natijalar yo‘q. O‘quvchilar mashq qilgach bu yerda ko‘rinadi.";
    hard.forEach(function(k){
      var d=document.createElement("div");d.className="hq";var t=document.createElement("div");t.style.fontWeight="600";t.textContent=k;
      var p=document.createElement("div");p.style.color="var(--muted)";p.textContent=qs[k].w+" marta xato / "+qs[k].c+" ta javob";
      var bar=document.createElement("div");bar.className="bar";var i=document.createElement("i");i.style.width=Math.round(qs[k].w/qs[k].c*100)+"%";bar.appendChild(i);
      d.appendChild(t);d.appendChild(p);d.appendChild(bar);H.appendChild(d);
    });
    var T=$("r_t");T.innerHTML="";var hr=document.createElement("tr");
    ["O‘quvchi","Javoblar","To‘g‘ri","O‘rtacha daraja"].forEach(function(x){var th=document.createElement("th");th.textContent=x;hr.appendChild(th)});T.appendChild(hr);
    Object.keys(names).sort().forEach(function(k){
      var n=names[k],tr=document.createElement("tr");
      [k,n.c,Math.round(n.ok/n.c*100)+"%",(n.l/n.c).toFixed(1)].forEach(function(x){var td=document.createElement("td");td.textContent=x;tr.appendChild(td)});T.appendChild(tr);
    });
  }
  $("r_cls").addEventListener("change",render);
  $("r_clr").addEventListener("click",function(){sv(RK,[]);render();});
  window.addEventListener("hashchange",function(){if(location.hash==="#natija"){fillCls();render();}});
  fillCls();render();
})();
</script>
</body>
</html>
