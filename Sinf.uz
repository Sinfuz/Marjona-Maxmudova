"Biologiya":{e:[["O‘simliklar fotosintezda qaysi gazni yutadi?",["Kislorod","Karbonat angidrid","Azot"],1],["Inson yuragi nechta kameradan iborat?",["2","3","4"],2],["Qaysi organ nafas olishga xizmat qiladi?",["Jigar","O‘pka","Buyrak"],1]],h:[["Hujayraning boshqaruv markazi nima?",["Yadro","Mitoxondriya","Vakuola"],0],["Qon aylanishi qanday doiralarga bo‘linadi?",["Uzun va qisqa","Katta va kichik","Ichki va tashqi"],1],["O‘simlik bargini yashil rangga bo‘yovchi modda qaysi?",["Gemoglobin","Insulin","Xlorofill"],2]]},
"Geografiya":{e:[["O‘zbekistonning poytaxti qaysi shahar?",["Samarqand","Toshkent","Buxoro"],1],["Eng katta okean qaysi?",["Atlantika","Tinch okeani","Hind okeani"],1],["Dunyodagi eng baland tog‘ cho‘qqisi qaysi?",["Everest (Jomolungma)","Elbrus","Alp"],0]],h:[["Orol dengizi qaysi ikki davlat hududida joylashgan?",["Qirg‘iziston va Tojikiston","O‘zbekiston va Qozog‘iston","O‘zbekiston va Eron"],1],["Eng katta qit’a qaysi?",["Afrika","Yevroosiyo","Avstraliya"],1],["Ekvator Yerni qanday qismlarga ajratadi?",["Sharqiy va G‘arbiy yarimsharga","Uch qismga","Shimoliy va Janubiy yarimsharga"],2]]},
"O‘zbekiston tarixi":{e:[["Amir Temur qaysi shaharni poytaxt qilgan?",["Toshkent","Samarqand","Xiva"],1],["O‘zbekiston Mustaqillik kuni qachon nishonlanadi?",["21 mart","8 dekabr","1 sentabr"],2],["Registon maydoni qaysi shaharda joylashgan?",["Samarqand","Buxoro","Qarshi"],0]],h:[["Mirzo Ulug‘bek qaysi fan sohasi bilan mashhur?",["Tibbiyot","Astronomiya","Dengizchilik"],1],["Al-Xorazmiy qaysi fanning asoschilaridan biri?",["Zoologiya","Arxeologiya","Algebra"],2],["Amir Temur qaysi yilda tug‘ilgan?",["1405","1336","1500"],1]]},
"Jahon tarixi":{e:[["Qadimgi Misr hukmdorlari qanday nomlangan?",["Fir’avn","Sulton","Imperator"],0],["Olimpiya o‘yinlari qaysi qadimgi mamlakatda boshlangan?",["Xitoy","Yunoniston","Hindiston"],1],["Ikkinchi jahon urushi qaysi yili tugagan?",["1939","1950","1945"],2]],h:[["Buyuk Fransuz inqilobi qaysi yili boshlangan?",["1812","1789","1917"],1],["AQSh mustaqilligi qaysi yili e’lon qilingan?",["1812","1776","1861"],1],["Birinchi jahon urushi qaysi yili boshlangan?",["1905","1939","1914"],2]]},
