      <div class="swatches" role="group" aria-label="Avatar rangi"><button class="sw" type="button" data-c="#0F9D8A" style="background:#0F9D8A" aria-label="Zumrad"></button><button class="sw" type="button" data-c="#FF6B4A" style="background:#FF6B4A" aria-label="Marjon"></button><button class="sw" type="button" data-c="#5B8DEF" style="background:#5B8DEF" aria-label="Ko‘k"></button><button class="sw" type="button" data-c="#9B6BDF" style="background:#9B6BDF" aria-label="Binafsha"></button><button class="sw" type="button" data-c="#E0A100" style="background:#E0A100" aria-label="Sariq"></button></div>
