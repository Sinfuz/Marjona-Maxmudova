"Algebra":{e:[["5² = ?",["10","25","52"],1],["√49 = ?",["7","6","8"],0],["x + 9 = 15 bo‘lsa, x = ?",["5","7","6"],2]],h:[["x² = 81 tenglamaning musbat ildizi qaysi?",["9","8","27"],0],["2x − 7 = 11 bo‘lsa, x = ?",["8","9","10"],1],["(a + b)² formulasi qaysi?",["a² + b²","a² − b²","a² + 2ab + b²"],2]]},
