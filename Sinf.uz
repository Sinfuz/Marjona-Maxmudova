<script>
(function(){return;
  var names=["Aziza","Bekzod","Dilnoza","Jasur","Madina","Sardor","Zarina","Otabek"];
  var cols=["#0F9D8A","#FF6B4A","#FFC83D","#5B8DEF","#9B6BDF"];
  var g=document.getElementById("wheel"),n=names.length,a=2*Math.PI/n,R=100,NS="http://www.w3.org/2000/svg";
  function build(){
  g.innerHTML="";g.style.transition="none";g.style.transform="rotate(0deg)";rot=0;n=names.length;a=2*Math.PI/n;
  names.forEach(function(nm,i){
    var s=i*a-Math.PI/2-a/2,e=s+a;
    var p=document.createElementNS(NS,"path");
    p.setAttribute("d","M0 0 L"+R*Math.cos(s)+" "+R*Math.sin(s)+" A"+R+" "+R+" 0 0 1 "+R*Math.cos(e)+" "+R*Math.sin(e)+" Z");
    p.setAttribute("fill",cols[i%cols.length]);p.setAttribute("stroke","#fff");p.setAttribute("stroke-width","2.5");
    g.appendChild(p);
    var t=document.createElementNS(NS,"text"),m=i*a-Math.PI/2,x=62*Math.cos(m),y=62*Math.sin(m);
    t.setAttribute("x",x);t.setAttribute("y",y);
    t.setAttribute("transform","rotate("+(i*360/n)+" "+x+" "+y+")");
    t.setAttribute("text-anchor","middle");t.setAttribute("dominant-baseline","middle");
    t.setAttribute("font-size",n>10?"8":n>8?"9.5":"11");t.setAttribute("font-weight","700");t.setAttribute("font-family","Onest,sans-serif");
    t.setAttribute("fill",cols[i%cols.length]==="#FFC83D"?"#0E2A33":"#fff");t.textContent=nm.length>11?nm.slice(0,10)+"…":nm;
    g.appendChild(t);
  });
  void g.getBoundingClientRect();g.style.transition="";}
  var rot=0,busy=false,btn=document.getElementById("spin"),out=document.getElementById("pick");
  try{var sv=JSON.parse(localStorage.getItem("sinf_names")||"null");if(sv&&sv.length>1)names=sv;}catch(e){}
  var L=document.getElementById("lights");
  for(var k=0;k<20;k++){var an=k*Math.PI/10,c=document.createElementNS(NS,"circle");c.setAttribute("cx",104.5*Math.cos(an));c.setAttribute("cy",104.5*Math.sin(an));c.setAttribute("r","2.4");c.setAttribute("class","lt"+(k%2));L.appendChild(c);}
  build();
  var ed=document.getElementById("editor"),ta=document.getElementById("names");
  document.getElementById("edit").addEventListener("click",function(){if(busy)return;ta.value=names.join("\n");ed.hidden=!ed.hidden;});
  document.getElementById("apply").addEventListener("click",function(){
    if(busy)return;
    var list=ta.value.split("\n").map(function(s){return s.trim()}).filter(Boolean).slice(0,12);
    if(list.length<2){ta.focus();out.textContent="Kamida 2 ta ism kiriting.";return;}
    names=list;build();
    try{localStorage.setItem("sinf_names",JSON.stringify(list))}catch(e){}
    out.textContent="Yangi ro‘yxat tayyor: aylantiring!";btn.textContent="Aylantirish";ed.hidden=true;
  });
  btn.addEventListener("click",function(){
    if(busy)return;busy=true;btn.disabled=true;
    var idx=Math.floor(Math.random()*n);
    rot=Math.ceil(rot/360)*360+360*6+(360-idx*360/n);
    g.style.transform="rotate("+rot+"deg)";
    var reduce=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    setTimeout(function(){
      out.innerHTML="Doskaga chiqadi:<strong>"+names[idx]+"</strong>";
      busy=false;btn.disabled=false;btn.textContent="Yana aylantirish";
    },reduce?50:4300);
  });
})();
</script>
<script>
(function(){
  var pages=["bosh","yechim","uyvazifa","fanlar","aloqa","kirish","kabinet","jurnal","natija"];
  function show(){
    var h=location.hash.replace("#","");
    if(pages.indexOf(h)<0)h="bosh";
    if(document.body.classList.contains("authed")&&(h==="yechim"||h==="aloqa"))h="bosh";
    document.querySelectorAll(".page").forEach(function(e){e.classList.toggle("on",e.getAttribute("data-page")===h)});
    document.querySelectorAll("nav a").forEach(function(a){if(a.getAttribute("href")==="#"+h)a.setAttribute("aria-current","page");else a.removeAttribute("aria-current")});
    window.scrollTo(0,0);
  }
  window.addEventListener("hashchange",show);
  show();
})();
</script>
<script>
(function(){
  var m=document.querySelector(".meter"),t=document.getElementById("mtog"),x=document.getElementById("mtxt");
  t.addEventListener("click",function(){var on=m.classList.toggle("on");
    t.textContent=on?"Oddiy darsga qaytish":"Interaktiv doskani yoqish";
    x.textContent=on?"Doskada o‘yin ketmoqda: diqqat 100% doskada va darslikda.":"Faqat ma’ruza va qog‘oz darslik: bolalarning fikri telefonda.";});
  var qa=document.getElementById("qa"),qr=document.getElementById("qr");
  qa.addEventListener("click",function(e){var b=e.target.closest(".chip");if(!b)return;
    qa.querySelectorAll(".chip").forEach(function(c){c.classList.remove("good","bad")});
    var ok=b.getAttribute("data-ok")==="1";b.classList.add(ok?"good":"bad");
    qr.textContent=ok?"To‘g‘ri! Tizim avtomatik tekshirdi va ballni yozdi.":"Yana urinib ko‘ring: tizim xatoni o‘zi belgilaydi.";
    if(ok)boom();});
  var r=document.getElementById("hrs"),hv=document.getElementById("hv"),hr=document.getElementById("hr");
  function calc(){hv.textContent=r.value;hr.textContent="Taxminan "+Math.round(r.value*0.8)+" soat bo‘sh vaqt: bu “5 baravargacha” tejash hisobi.";}
  r.addEventListener("input",calc);calc();
  function boom(){if(window.matchMedia("(prefers-reduced-motion: reduce)").matches)return;
    var em=["🎉","⭐","✨","🎈"];
    for(var i=0;i<24;i++){(function(i){var s=document.createElement("span");s.className="conf";s.textContent=em[i%4];s.style.left=Math.random()*100+"vw";s.style.animationDelay=Math.random()*.5+"s";document.body.appendChild(s);setTimeout(function(){s.remove()},2700);})(i);}}
  window.sinfBoom=boom;new MutationObserver(function(){if(document.querySelector("#pick strong"))boom();}).observe(document.getElementById("pick"),{childList:true});
})();
</script>
<script>
(function(){
  var box=document.getElementById("authbox"),ft=document.getElementById("f-t"),fs=document.getElementById("f-s"),dash=document.getElementById("dash");
  function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
  box.querySelector(".seg").addEventListener("click",function(e){var b=e.target.closest(".chip");if(!b)return;
    box.querySelectorAll(".seg .chip").forEach(function(c){c.classList.toggle("on",c===b)});
    var t=b.getAttribute("data-role")==="t";ft.hidden=!t;fs.hidden=t;dash.hidden=true;});
  document.getElementById("tgo").addEventListener("click",function(){
    var n=document.getElementById("tn").value.trim();if(!n){document.getElementById("tn").focus();return;}
    var pw=document.getElementById("tp").value,tm=document.getElementById("tmsg");
    if(pw.length<6&&!document.getElementById("tgo").dataset.skip){tm.textContent="Parol kamida 6 ta belgidan iborat bo‘lsin.";document.getElementById("tp").focus();return;}
    tm.textContent="";document.getElementById("tp").value="";
    var code="7B-"+(1000+Math.floor(Math.random()*9000)),rows=[["Aziza",85],["Bekzod",72],["Dilnoza",91],["Jasur",64]];
    dash.innerHTML="<h3>Xush kelibsiz, "+esc(n)+"</h3><p>Sinfingiz kodi (o‘quvchilarga bering):<br><span class=\"code\">"+code+"</span></p><table class=\"list\"><tr><th>O‘quvchi</th><th>Ball</th></tr>"+rows.map(function(r){return "<tr><td>"+r[0]+"</td><td>"+r[1]+"</td></tr>"}).join("")+"</table><p style=\"color:var(--muted)\">Namuna ma’lumotlar. Ballarni Emaktab jurnaliga yuborish: tez orada.</p>";
    ft.hidden=true;dash.hidden=false;document.querySelector('nav a[href="#kirish"]').hidden=true;window.sinfLogin&&window.sinfLogin("O‘qituvchi",n);window.sinfTeacher&&window.sinfTeacher(dash,n);
    var lo=document.createElement("button");lo.type="button";lo.className="linkbtn";lo.textContent="Chiqish";
    lo.addEventListener("click",function(){dash.hidden=true;ft.hidden=false;document.querySelector('nav a[href="#kirish"]').hidden=false;window.sinfLogout&&window.sinfLogout();});dash.appendChild(lo);});
  document.getElementById("sgo").addEventListener("click",function(){
    var n=document.getElementById("sn").value.trim(),c=document.getElementById("sc").value.trim();
    if(!n){document.getElementById("sn").focus();return;}if(!c){document.getElementById("sc").focus();return;}
    dash.innerHTML="<h3>Salom, "+esc(n)+"!</h3><p>Siz <b>"+esc(c)+"</b> sinfiga qo‘shildingiz.</p><p>Sizning ballingiz: <b id='sq-pts'>0</b></p><div id='sq'></div><p style=\"color:var(--muted)\"><button class='linkbtn' id='sq-out' type='button'>Chiqish</button></p>";
    fs.hidden=true;dash.hidden=false;document.querySelector('nav a[href="#kirish"]').hidden=true;window.sinfLogin&&window.sinfLogin("O‘quvchi",n);window.sinfStudentInfo&&window.sinfStudentInfo(dash,c);
    var qs=[["7 × 8 = ?",["54","56","64"],1],["Suv necha gradusda qaynaydi?",["50 °C","100 °C","150 °C"],1],["O‘zbekiston poytaxti qaysi shahar?",["Samarqand","Buxoro","Toshkent"],2]],qi=0,pts=0,box=document.getElementById("sq");
    function ask(){
      if(qi>=qs.length){box.innerHTML="<p><b>Kvest tugadi!</b> Natija: "+pts+" ball.</p>";return;}
      var q=qs[qi];box.innerHTML="<p><b>"+q[0]+"</b></p>";
      q[1].forEach(function(t,j){var b=document.createElement("button");b.type="button";b.className="chip";b.textContent=t;
        b.addEventListener("click",function(){var ok=j===q[2];b.classList.add(ok?"good":"bad");if(ok)pts+=10;document.getElementById("sq-pts").textContent=pts;
          box.querySelectorAll(".chip").forEach(function(x){x.disabled=true});
          setTimeout(function(){qi++;ask();},700);});
        box.appendChild(b);});
    }
    var BANK={
      "Matematika":{e:[["6 + 7 = ?",["12","13","14"],1],["9 × 3 = ?",["26","27","36"],1],["20 − 8 = ?",["14","10","12"],2]],h:[["12 × 12 = ?",["124","144","154"],1],["3x + 5 = 20 bo‘lsa, x = ?",["6","4","5"],2],["80 ning 25% i nechaga teng?",["20","15","25"],0]]},
      "Fizika":{e:[["Suv necha °C da qaynaydi?",["100","50","150"],0],["Tovush qayerda tarqalmaydi?",["Havoda","Vakuumda","Suvda"],1],["Quyidagilardan qaysi biri kuch birligi?",["Metr","Sekund","Nyuton"],2]],h:[["120 km yo‘lni 2 soatda bosib o‘tgan avtomobilning tezligi qancha?",["60 km/soat","40 km/soat","240 km/soat"],0],["Yorug‘likning vakuumdagi tezligi taxminan qancha?",["30 000 km/s","3 000 km/s","300 000 km/s"],2],["U = 12 V va R = 4 Ω bo‘lsa, tok kuchi I = ?",["2 A","3 A","48 A"],1]]},
      "Tarix":{e:[["Amir Temur qaysi shaharni poytaxt qilgan?",["Toshkent","Samarqand","Xiva"],1],["O‘zbekiston Mustaqillik kuni qachon nishonlanadi?",["21 mart","8 dekabr","1 sentabr"],2],["Registon maydoni qaysi shaharda joylashgan?",["Samarqand","Buxoro","Qarshi"],0]],h:[["Mirzo Ulug‘bek qaysi fan sohasi bilan mashhur?",["Tibbiyot","Astronomiya","Dengizchilik"],1],["Al-Xorazmiy qaysi fanning asoschilaridan biri?",["Zoologiya","Arxeologiya","Algebra"],2],["Amir Temur qaysi yilda tug‘ilgan?",["1405","1336","1500"],1]]},
      "Ingliz tili":{e:[["“Apple” o‘zbekchada nima?",["Nok","Olma","Uzum"],1],["“Book” so‘zi nimani anglatadi?",["Qalam","Stol","Kitob"],2],["“Red” qaysi rang?",["Qizil","Ko‘k","Yashil"],0]],h:[["To‘g‘ri variantni tanlang: She ___ to school every day.",["go","goes","going"],1],["“Beautiful” so‘zining sinonimi qaysi?",["Ugly","Small","Pretty"],2],["Yesterday I ___ football.",["played","play","plays"],0]]}
    },tot=0;
    function mk(t){var b=document.createElement("button");b.type="button";b.className="chip";b.textContent=t;return b;}
    function startFlow(){
      box.innerHTML="<p><b>Qaysi fanni o‘rganmoqchisiz?</b></p>";
      var BK=window.SB||BANK;Object.keys(BK).forEach(function(s){var b=mk(s);b.addEventListener("click",function(){chooseMode(s)});box.appendChild(b);});
    }
    function chooseMode(s){
      box.innerHTML="<p><b></b></p>";box.querySelector("b").textContent=s+": qanday o‘rganasiz?";
      var a=mk("⏱️ 10 daqiqa (oddiy savollar)"),h=mk("📚 Uy vazifasi (murakkabroq savollar)");
      a.addEventListener("click",function(){run(s,"e")});h.addEventListener("click",function(){run(s,"h")});
      box.appendChild(a);box.appendChild(h);
    }
    function run(s,lv){
      var list=(window.SB||BANK)[s][lv],i=0,sc=0;
      (function next(){
        if(i>=list.length){tot+=sc;finish(sc,s,lv);return;}
        var q=list[i];box.innerHTML="<p><small></small><br><b></b></p>";
        box.querySelector("small").textContent=s+" · "+(lv==="e"?"10 daqiqa":"Uy vazifasi")+" · "+(i+1)+"/"+list.length;
        box.querySelector("b").textContent=q[0];
        q[1].forEach(function(t,j){var b=mk(t);b.addEventListener("click",function(){
          var ok=j===q[2];b.classList.add(ok?"good":"bad");if(ok)sc+=10;window.sinfLog&&window.sinfLog({q:q[0],ok:ok,s:s,l:lv==="h"?4:2});
          document.getElementById("sq-pts").textContent=tot+sc;
          box.querySelectorAll(".chip").forEach(function(x){x.disabled=true});
          setTimeout(function(){i++;next();},700);});box.appendChild(b);});
      })();
    }
    function finish(sc,s,lv){
      var m=sc>=30?["Tabriklaymiz! Ajoyib natija, siz haqiqiy yulduzsiz!","🌟🎉🏆🎈✨"]:sc>=20?["Barakalla! Juda yaxshi natija!","🎉👏😊"]:sc>=10?["Yaxshi urinish! Yana bir bor harakat qiling, albatta eplaysiz!","💪🙂"]:["Xafa bo‘lmang! Har bir xato yangi bilimga yo‘l ochadi. Qayta urinib ko‘ring!","🌱"];
      box.innerHTML="<p style='font-size:20px'><b></b></p><p></p>";
      box.querySelector("b").textContent=m[0]+" "+m[1];
      box.querySelectorAll("p")[1].textContent="Bu urinishdagi natija: "+sc+" / 30 ball.";
      if(sc>=20&&window.sinfBoom){window.sinfBoom();if(sc>=30)setTimeout(window.sinfBoom,600);}
      var more=mk("♾️ Davom etish: moslashuvchan mashq");more.addEventListener("click",function(){window.sinfPractice&&window.sinfPractice(box,s,lv==="h"?4:2,function(d){tot+=d;document.getElementById("sq-pts").textContent=tot;},startFlow);});box.appendChild(more);
      var again=mk("Yana o‘rganish");again.addEventListener("click",startFlow);box.appendChild(again);
    }
    startFlow();
    document.getElementById("sq-out").addEventListener("click",function(){dash.hidden=true;fs.hidden=false;document.querySelector('nav a[href="#kirish"]').hidden=false;window.sinfLogout&&window.sinfLogout();});
  });
})();
</script>
<script>
(function(){
  var b=document.getElementById("cgo");
  b.addEventListener("click",function(){
    var n=document.getElementById("cn").value,s=document.getElementById("cs").value,m=document.getElementById("cm").value;
    b.href="mailto:xumo1694@gmail.com?subject="+encodeURIComponent("Sinf.uz: sinab ko‘rish so‘rovi")+"&body="+encodeURIComponent("Ism: "+n+"\nMaktab va sinf: "+s+"\n\n"+m);
  });
})();
</script>
<script>
(function(){
  var names=["Aziza","Bekzod","Dilnoza","Jasur","Madina","Sardor","Zarina","Otabek"];
  names=[];try{var sv=JSON.parse(localStorage.getItem("sinf_names")||"null");if(sv&&sv.length>1)names=sv;}catch(e){}
  var c=document.getElementById("sl-c"),p=document.getElementById("sl-p"),nx=document.getElementById("sl-n"),btn=document.getElementById("spin"),out=document.getElementById("pick"),busy=false;
  var reduce=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function nm(i){return names.length?names[(i%names.length+names.length)%names.length]:""}
  function show(i,anim){p.textContent=nm(i-1);c.textContent=nm(i);nx.textContent=nm(i+1);
    if(anim&&!reduce&&c.animate)c.animate([{transform:"translateY(-14px)",opacity:.35},{transform:"none",opacity:1}],{duration:110});}
  document.getElementById("names").value=names.join("\n");
  if(names.length){show(0);}else{c.textContent="Ismlarni yozing";}
  btn.addEventListener("click",function(){
    if(busy)return;
    if(names.length<2){out.textContent="Avval ismlarni yozing (kamida 2 ta) va “Ro‘yxatni qo‘llash” tugmasini bosing.";document.getElementById("editor").hidden=false;document.getElementById("names").focus();return;}
    busy=true;btn.disabled=true;c.classList.remove("win");
    var win=Math.floor(Math.random()*names.length),steps=reduce?1:26+Math.floor(Math.random()*names.length),i=win-steps,k=0;
    (function tick(){
      i++;k++;show(i,true);
      if(k<steps){setTimeout(tick,50+Math.pow(k/steps,3)*420);}
      else{c.classList.add("win");out.innerHTML="Doskaga chiqadi:<strong></strong>";out.querySelector("strong").textContent=names[win];busy=false;btn.disabled=false;btn.textContent="Yana aylantirish";}
    })();
  });
  var ed=document.getElementById("editor"),ta=document.getElementById("names");
  document.getElementById("edit").addEventListener("click",function(){if(busy)return;ta.value=names.join("\n");ed.hidden=!ed.hidden;});
  document.getElementById("apply").addEventListener("click",function(){
    if(busy)return;
    var list=ta.value.split("\n").map(function(s){return s.trim()}).filter(Boolean).slice(0,12);
    if(list.length<2){ta.focus();out.textContent="Kamida 2 ta ism kiriting.";return;}
    names=list;c.classList.remove("win");show(0);
    try{localStorage.setItem("sinf_names",JSON.stringify(list))}catch(e){}
    out.textContent="Yangi ro‘yxat tayyor: aylantiring!";btn.textContent="Aylantirish";ed.hidden=true;
  });
})();
</script>
<script>
(function(){
  var KEY="sinf_profile",P={name:"",school:"",cls:"",subj:"",email:"",phone:"",about:"",color:"#0F9D8A",role:""},F=["name","school","cls","subj","email","phone","about"];
  function $(id){return document.getElementById(id)}
  function load(){try{var s=JSON.parse(localStorage.getItem(KEY)||"null");if(s)for(var k in s)if(k in P&&typeof s[k]==="string")P[k]=s[k];}catch(e){}}
  function save(){try{localStorage.setItem(KEY,JSON.stringify(P))}catch(e){}}
  function fill(){F.forEach(function(k){$("k_"+k).value=P[k]})}
  function render(){
    $("kname").textContent=P.name||"Ism kiritilmagan";
    $("kav").textContent=(P.name.trim().charAt(0)||"?").toUpperCase();$("kav").style.background=P.color;
    $("krole").textContent=P.role;$("kmeta").textContent=[P.school,P.cls].filter(Boolean).join(" · ");
    $("klbl").textContent="Qiziqishlarim";
  }
  window.sinfLogin=function(role,name){window.sinfWho={role:role,name:name};document.body.classList.add("authed");document.body.classList.toggle("teacher",role==="O‘qituvchi");load();P.role=role;if(!P.name)P.name=name||"";save();
    $("navk").hidden=false;$("kgate").hidden=true;$("kbox").hidden=false;fill();render();};
  window.sinfLogout=function(){window.sinfWho=null;document.body.classList.remove("authed");document.body.classList.remove("teacher");$("navk").hidden=true;$("kgate").hidden=false;$("kbox").hidden=true;$("kmsg").textContent="";};
  document.querySelectorAll(".sw").forEach(function(b){b.addEventListener("click",function(){P.color=b.getAttribute("data-c");render();$("kmsg").textContent="Rang tanlandi. Saqlashni unutmang.";});});
  $("ksave").addEventListener("click",function(){
    F.forEach(function(k){P[k]=$("k_"+k).value.trim()});save();render();$("kmsg").textContent="Ma’lumotlaringiz saqlandi ✅";
  });
  $("kreset").addEventListener("click",function(){var r=P.role;load();P.role=r;fill();render();$("kmsg").textContent="O‘zgarishlar bekor qilindi.";});
})();
</script>
<script>
(function(){
  var KEY="sinf_classes",SUBJ=["Matematika","Fizika","Tarix","Ingliz tili","Boshqa fan"];
  function $(id){return document.getElementById(id)}
  function loadC(){try{var a=JSON.parse(localStorage.getItem(KEY)||"[]");return Array.isArray(a)?a:[];}catch(e){return [];}}
  function saveC(a){try{localStorage.setItem(KEY,JSON.stringify(a))}catch(e){}}
  function render(){
    var L=$("cn_list");L.innerHTML="";var cs=loadC();
    if(!cs.length){L.textContent="Hozircha sinf yo‘q.";return;}
    cs.forEach(function(c,i){
      var d=document.createElement("div");d.className="clscard";
      var l=document.createElement("div");l.style.fontWeight="600";l.textContent=c.name+" · "+c.subj;
      var code=document.createElement("span");code.className="ccode";code.textContent=c.code;
      var del=document.createElement("button");del.type="button";del.className="linkbtn";del.textContent="O‘chirish";
      del.addEventListener("click",function(){var a=loadC();a.splice(i,1);saveC(a);render();});
      d.appendChild(l);d.appendChild(code);d.appendChild(del);L.appendChild(d);
    });
  }
  window.sinfTeacher=function(dash,name){
    dash.innerHTML="<h3></h3><p>Sinf oching va fanni tanlang. O‘quvchilar sinf kodi bilan qo‘shiladi.</p>"+
      "<div class='krow'><div><label for='cn_name'>Sinf nomi</label><input class='in' id='cn_name' placeholder='Masalan: 7B'></div>"+
      "<div><label for='cn_subj'>Qaysi fan o‘rganiladi?</label><select class='in' id='cn_subj'>"+SUBJ.map(function(s){return "<option>"+s+"</option>"}).join("")+"</select></div></div>"+
      "<button class='btn' id='cn_go' type='button'>Sinf ochish</button><p id='cn_msg' aria-live='polite' style='color:var(--pen);font-weight:600'></p>"+
      "<h3 style='font-size:18px;margin-top:18px'>Mening sinflarim</h3><div id='cn_list'></div>";
    dash.querySelector("h3").textContent="Xush kelibsiz, "+name;
    render();
    $("cn_go").addEventListener("click",function(){
      var nm=$("cn_name").value.trim(),sb=$("cn_subj").value,a=loadC(),msg=$("cn_msg");
      if(!nm){$("cn_name").focus();msg.textContent="Sinf nomini yozing.";return;}
      if(a.length>=10){msg.textContent="Eng ko‘pi bilan 10 ta sinf ochish mumkin.";return;}
      var code,ok=false;
      while(!ok){code=nm.replace(/\s+/g,"").toUpperCase().slice(0,4)+"-"+(1000+Math.floor(Math.random()*9000));ok=!a.some(function(x){return x.code===code});}
      a.push({name:nm,subj:sb,code:code});saveC(a);$("cn_name").value="";
      msg.textContent="Sinf ochildi! Kodni o‘quvchilarga bering: "+code;render();
    });
  };
  window.sinfStudentInfo=function(dash,code){if(window.sinfWho)window.sinfWho.code=String(code).trim();
    var f=loadC().filter(function(x){return x.code.toUpperCase()===String(code).trim().toUpperCase()})[0];
    var p=dash.querySelector("p");
    if(f&&p)p.textContent="Siz "+f.name+" sinfiga qo‘shildingiz.";
  };
})();
</script>
<script>
(function(){
  var KEY="sinf_classes",TK="sinf_teacher_subj",SUBJ=["Matematika","Fizika","Tarix","Ingliz tili","Boshqa fan"];
  function $(id){return document.getElementById(id)}
  function loadC(){try{var a=JSON.parse(localStorage.getItem(KEY)||"[]");return Array.isArray(a)?a:[];}catch(e){return [];}}
  function saveC(a){try{localStorage.setItem(KEY,JSON.stringify(a))}catch(e){}}
  function getS(){try{return localStorage.getItem(TK)||""}catch(e){return ""}}
  function render(){
    var L=$("cn_list");L.innerHTML="";var cs=loadC();
    if(!cs.length){L.textContent="Hozircha sinf yo‘q.";return;}
    cs.forEach(function(c,i){
      var d=document.createElement("div");d.className="clscard";
      var l=document.createElement("div");l.style.fontWeight="600";l.textContent=c.name;
      var code=document.createElement("span");code.className="ccode";code.textContent=c.code;
      var del=document.createElement("button");del.type="button";del.className="linkbtn";del.textContent="O‘chirish";
      del.addEventListener("click",function(){var a=loadC();a.splice(i,1);saveC(a);render();});
      d.appendChild(l);d.appendChild(code);d.appendChild(del);L.appendChild(d);
    });
  }
  window.sinfTeacher=function(dash,name){
    dash.innerHTML="<h3></h3>"+
      "<div style='background:#F1FAF7;border-radius:16px;padding:16px;margin:10px 0'><label for='tc_subj'>Men dars beradigan fan</label>"+
      "<div class='krow'><select class='in' id='tc_subj'><option value=''>Fanni tanlang</option>"+Object.keys(window.SB||{}).map(function(s){return "<option>"+s+"</option>"}).join("")+"</select><div><button class='btn' id='tc_save' type='button'>Saqlash</button></div></div>"+
      "<p id='tc_msg' aria-live='polite' style='color:var(--pen);font-weight:600;margin:0'></p></div>"+
      "<h3 style='font-size:18px;margin-top:20px'>Mening sinflarim</h3><div id='cn_list'></div>"+
      "<button class='btn ghost' id='cn_open' type='button' style='margin:6px 0 0'>+ Sinf ochish</button>"+
      "<div id='cn_form' hidden style='margin-top:14px'><label for='cn_name'>Sinf nomi</label><input class='in' id='cn_name' placeholder='Masalan: 7B'>"+
      "<button class='btn' id='cn_go' type='button'>Sinfni yaratish</button><p id='cn_msg' aria-live='polite' style='color:var(--pen);font-weight:600'></p></div>";
    dash.querySelector("h3").textContent="Xush kelibsiz, "+name;
    $("tc_subj").value=getS();render();
    $("tc_save").addEventListener("click",function(){
      var v=$("tc_subj").value;
      if(!v){$("tc_msg").textContent="Avval fanni tanlang.";return;}
      try{localStorage.setItem(TK,v)}catch(e){}
      $("tc_msg").textContent="Saqlandi: siz "+v+" fanidan dars berasiz.";
    });
    $("cn_open").addEventListener("click",function(){var f=$("cn_form");f.hidden=!f.hidden;if(!f.hidden)$("cn_name").focus();});
    $("cn_go").addEventListener("click",function(){
      var nm=$("cn_name").value.trim(),sb=getS(),a=loadC(),msg=$("cn_msg");
      if(!sb){msg.textContent="Avval yuqorida dars beradigan fanni tanlab, “Saqlash” tugmasini bosing.";return;}
      if(!nm){$("cn_name").focus();msg.textContent="Sinf nomini yozing.";return;}
      if(a.length>=10){msg.textContent="Eng ko‘pi bilan 10 ta sinf ochish mumkin.";return;}
      var code,ok=false;
      while(!ok){code=nm.replace(/\s+/g,"").toUpperCase().slice(0,4)+"-"+(1000+Math.floor(Math.random()*9000));ok=!a.some(function(x){return x.code===code});}
      a.push({name:nm,subj:sb,code:code});saveC(a);$("cn_name").value="";
      msg.textContent="Sinf ochildi! Kodni o‘quvchilarga bering: "+code;render();
    });
  };
})();
</script>
